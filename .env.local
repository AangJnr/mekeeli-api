# --- Local Development Settings ---
# This file is for local development and should NOT be committed to git.
# It is loaded automatically by the application.

SECRET_KEY="your_super_secret_key_change_me"

# For local development, we point to the sql.db file in the project root.
DATABASE_URL="sqlite:///./sql.db"

# --- Production Example ---
# In production, you would set this environment variable to point to your PostgreSQL container.
# For example: DATABASE_URL="postgresql://prod_user:prod_password@postgres_db:5432/prod_db"
